# Copy this file to .env and set your key/passwords. Do not commit .env.
OPENAI_API_KEY=

# Canvas API (single-token dev; optional — backend works without these)
CANVAS_BASE_URL=https://canvas.wisc.edu
CANVAS_ACCESS_TOKEN=YOUR_CANVAS_ACCESS_TOKEN

# MySQL env vars
MYSQL_DATABASE=ooc
MYSQL_USER=ooc
MYSQL_PASSWORD=ooc_password # change to actual password
MYSQL_ROOT_PASSWORD=root_password # change to actual password

BACKEND_PORT=8080
MYSQL_PORT=3306